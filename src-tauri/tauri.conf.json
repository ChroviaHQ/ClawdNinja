{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClawdNinja",
  "version": "../package.json",
  "identifier": "com.getchrovia.clawdninja",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "ClawdNinja",
        "width": 400,
        "height": 408,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        },
        "resizable": false,
        "maximizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Keep every Claude app on your network route.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 ChroviaHQ",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyQzBFMjk1RUQ3NjI5ODYKUldTR0tYYnRsZUxBZ2hiellvTDVVV0dkbjkvcktzV2dpWlVUZW5Fbk5qaEdDVnozTUhWYVM0RFoK",
      "endpoints": [
        "https://github.com/ChroviaHQ/clawdninja/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
